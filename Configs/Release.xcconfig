MARKETING_VERSION = 1.7.1
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 16.0
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0

// festy: shipping identity (team + bundle id + app group). Do NOT change
// these for local builds; put your own team/bundle in Configs/Local.xcconfig
// (gitignored, see Local.xcconfig.example and docs/LOCAL_SIGNING.md).
DEVELOPMENT_TEAM = 9ZYQ3XT8L9
CODE_SIGN_STYLE = Automatic

PRODUCT_BUNDLE_IDENTIFIER = com.meshed.app

// Active trip: file name (no .json) in bitchat/Features/festival/trips/.
// Switch trips by changing this line. See docs/NEW_TRIP.md.
MESHY_TRIP = trip-ge136c-spring-2026

// App Group identifier for sharing data between main app and extensions.
// Upstream reads APP_GROUP_ID (Info.plist `AppGroupID`, entitlements);
// APP_GROUP_IDENTIFIER is kept for festy's older local configs.
APP_GROUP_ID = group.$(PRODUCT_BUNDLE_IDENTIFIER)
APP_GROUP_IDENTIFIER = $(APP_GROUP_ID)

// Per-developer overrides (gitignored). Must stay last so it wins.
#include? "Local.xcconfig"
